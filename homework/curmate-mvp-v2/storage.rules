// ─────────────────────────────────────────────────────────────
// storage.rules — Firebase Storage Security Rules ของการบ้าน curmate-mvp-v2
// (เพิ่มเมื่อสัปดาห์ที่ 8 — ก่อนหน้านี้ไม่ได้ใช้ Firebase Storage เลย)
//
// วิธีใช้ไฟล์นี้: ไม่มี Firebase CLI ตั้งค่าไว้ในโฟลเดอร์นี้ (เหมือน firestore.rules)
// ต้องก็อปเนื้อหาทั้งหมดด้านล่างไปวางเองที่ Firebase Console →
// โปรเจกต์ cur-mate → Storage → แท็บ "Rules" → วางทับของเดิม → Publish
// (ถ้ายังไม่เคยเปิดใช้ Storage มาก่อน ต้องกด "Get started" ที่ Storage ในคอนโซลก่อน 1 ครั้ง)
//
// ข้อจำกัดที่ตั้งใจ: Storage Rules ไม่ได้เช็ค role ADMIN/STAFF แบบเดียวกับ firestore.rules
// (เช็คแค่ "login แล้วหรือยัง") เพราะการเช็ค role จริงต้องข้ามไปอ่าน Firestore จากฝั่ง Storage Rules
// ซึ่งซับซ้อนเกินความจำเป็นของการบ้านนี้ — ฝั่ง UI (js/create-criteria-set.js) บังคับ ADMIN ล้วนอยู่แล้ว
// สำหรับการอัปโหลด ส่วนการอ่าน/เปิดดูไฟล์ (ปุ่ม "ดูเอกสารต้นฉบับ") เปิดให้ทั้ง ADMIN และ STAFF ที่ login แล้ว
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // criteriaDocuments/{setId}/{fileName} — ไฟล์ PDF ต้นฉบับที่อัปโหลดตอนสร้าง/สกัดชุดเกณฑ์
    match /criteriaDocuments/{setId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // path อื่นนอกเหนือจากนี้: ปฏิเสธโดยปริยาย
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
